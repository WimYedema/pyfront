Front ROOT ::= rules: {Rule} scan_rules: {ScanRule};

Rule ::= 
    name: Ident is_root: ["ROOT"] super_type: ["<" Ident ] "::=" 
    fields: {Field}
    terms: SymbolSequence
    choices: [ "<" ( Choice / "|" ) ">"] ";"
    ;

Choice ::=
    < RuleChoice ::= rule: Rule
    | SymbolsChoice ::= symbols: SymbolSequence
    >;

SymbolSequence ::= symbols: {SeparatedSymbol};

Symbol ::= < LabeledSymbol | ReferenceSymbol | StringSymbol | GroupSymbol | OptionalSymbol | MoreSymbol >;
SeparatedSymbol < Symbol ::= symbol: Symbol ["/" separator: String];

LabeledSymbol < Symbol ::= label: Ident ":" symbol: Symbol ;
ReferenceSymbol < Symbol ::= name: Ident;
StringSymbol < Symbol ::= value: String;
GroupSymbol < Symbol ::= "(" symbols: {SeparatedSymbol} ")";
OptionalSymbol < Symbol ::= "[" symbols: {SeparatedSymbol} "]";
MoreSymbol < Symbol ::= "{" symbols: {SeparatedSymbol} "}" plus: ["+"];

Field ::= "FIELD" name: String ":" symbol: Symbol value: [ "=" Expression ];

Expression ::= 
    < IdExpr ::= id: Ident 
    | StringExpr ::= value: String 
    | IntExpr ::= value: Int 
    | FloatExpr ::= value: Float
    | TrueExpr ::= "True"
    | FalseExpr ::= "False"
    | NoneExpr ::= "None"
    >;

ScanRule ::= 
    "SCAN" name: String ":" type: Ident "::=" pattern: String;

SCAN String: String ::= "\"(?:[^\"\\]|\\.)*\"";
SCAN Ident: Ident ::= "[a-zA-Z_][a-zA-Z0-9_]*";
SCAN Int: Int ::= "[0-9]+";
SCAN Float: Float ::= "[0-9]+\.[0-9]+";
